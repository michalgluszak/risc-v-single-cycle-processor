#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x57277b7fda20 .scope module, "adder_tb" "adder_tb" 2 3;
 .timescale -9 -12;
v0x57277b80ed90_0 .var "a", 31 0;
v0x57277b80ee80_0 .var "b", 31 0;
v0x57277b80ef50_0 .net "y", 31 0, L_0x57277b80f050;  1 drivers
S_0x57277b7fdbb0 .scope module, "uut" "adder" 2 7, 3 3 0, S_0x57277b7fda20;
 .timescale -9 -12;
    .port_info 0 /INPUT 32 "a";
    .port_info 1 /INPUT 32 "b";
    .port_info 2 /OUTPUT 32 "y";
v0x57277b7ebc80_0 .net "a", 31 0, v0x57277b80ed90_0;  1 drivers
v0x57277b80eb70_0 .net "b", 31 0, v0x57277b80ee80_0;  1 drivers
v0x57277b80ec50_0 .net "y", 31 0, L_0x57277b80f050;  alias, 1 drivers
L_0x57277b80f050 .arith/sum 32, v0x57277b80ed90_0, v0x57277b80ee80_0;
    .scope S_0x57277b7fda20;
T_0 ;
    %vpi_call 2 13 "$monitor", "a = %0d b = %0d y = %0d", v0x57277b80ed90_0, v0x57277b80ee80_0, v0x57277b80ef50_0 {0 0 0};
    %pushi/vec4 5, 0, 32;
    %store/vec4 v0x57277b80ed90_0, 0, 32;
    %pushi/vec4 3, 0, 32;
    %store/vec4 v0x57277b80ee80_0, 0, 32;
    %delay 10000, 0;
    %pushi/vec4 101, 0, 32;
    %store/vec4 v0x57277b80ed90_0, 0, 32;
    %pushi/vec4 53, 0, 32;
    %store/vec4 v0x57277b80ee80_0, 0, 32;
    %delay 10000, 0;
    %vpi_call 2 18 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "adder_tb.v";
    "adder.v";
